{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "shuttle-io",
  "version": "0.1.0",
  "identifier": "io.shuttle.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "shuttle-io",
        "width": 1100,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "transparent": true
      },
      {
        "label": "spotlight",
        "title": "shuttle-io",
        "width": 600,
        "height": 260,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "skills/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}