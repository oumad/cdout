{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "shuttle-io",
  "version": "0.1.0",
  "identifier": "io.shuttle.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "shuttle-io",
        "width": 800,
        "height": 600,
        "decorations": false,
        "transparent": true
      },
      {
        "label": "spotlight",
        "title": "shuttle-io",
        "width": 600,
        "height": 260,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "skills/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}