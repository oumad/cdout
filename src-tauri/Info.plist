<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Merged into the generated Info.plist by tauri-bundler on macOS builds.

  NSAppleEventsUsageDescription is not optional: without it, the first Apple
  event cdout sends to Finder is rejected outright (errAEEventNotPermitted,
  -1743) instead of raising a consent dialog, so file-manager awareness fails
  with no way for the user to grant it. The string is what the dialog shows.
-->
<plist version="1.0">
<dict>
  <key>NSAppleEventsUsageDescription</key>
  <string>cdout reads the folder you have open in Finder and the files you have selected, so you can say "rename these" without typing filenames.</string>
  <key>LSApplicationCategoryType</key>
  <string>public.app-category.productivity</string>
</dict>
</plist>
